{
  "description": "just-module-creator: the provenance ledger (RM31), for Codex. Runs once the author has reviewed it in /hooks. JMC_TRACE=0 turns it off.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [{"type": "command", "command": "uv run --no-project python -I \"${PLUGIN_ROOT}/src/just_module_creator/tracehook.py\" pre", "timeout": 10}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*just-module-creator.*__(literature_search|fetch_fulltext|lookup_variant)|apply_patch|Edit|Write",
        "hooks": [{"type": "command", "command": "uv run --no-project python -I \"${PLUGIN_ROOT}/src/just_module_creator/tracehook.py\" post", "timeout": 10}]
      }
    ]
  }
}
